{
  // Put this file at ~/.config/opencode/opencode.jsonc on the machine
  // that runs `opencode`. Replace LLM_SERVER_IP with your GPU server's LAN IP.
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://LLM_SERVER_IP:8000/v1",
        "apiKey": "local"
      },
      "models": {
        "qwen": { "name": "Qwen-Coder-7B (local)" },
        "hermes": { "name": "Hermes-2-Pro-8B (local)" }
      }
    }
  }
}
